# ─────────────────────────────────────────────────────────────────────────────
# dine-backend — OFFLINE / LOCAL SERVER config (pg-full-migration branch)
#
# Copy to `.env.local` on the ONE terminal that acts as the restaurant's server:
#     cp .env.offline.example .env.local
# then edit the values below. Every other terminal on the LAN points its API base
# at http://<this-machine-ip>:3003 and needs NO backend of its own.
#
# See docs/offline-local-server.md for the full setup runbook.
# ─────────────────────────────────────────────────────────────────────────────

# --- Core (required) --------------------------------------------------------
# Local Postgres on THIS machine. No SSL for localhost. Create the DB + schema
# per the runbook before first start.
DATABASE_URL=postgresql://dine_app:CHANGE_ME@localhost:5432/dine

# Must match the JWT_SECRET used to mint the staff/owner tokens you'll log in with.
# Use the SAME value as production so tokens/logins are interchangeable online<->offline.
JWT_SECRET=CHANGE_ME_SAME_AS_PRODUCTION

# Port the local server listens on (all terminals connect here).
PORT=3003
NODE_ENV=production

# --- Redis: LEAVE UNSET offline -------------------------------------------
# With KV_REST_API_* unset, the pgAdapter cache short-circuits straight to Postgres
# (no 2s cloud timeouts). Do NOT set these on the offline server.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Firebase Admin: OPTIONAL offline --------------------------------------
# The server boots Postgres-only if these are absent (see firebase.js offline guard).
# Provide them if you want cloud sync / RTDB when the internet is up. They are parsed
# locally (no network at boot). Keep the \n escapes in the private key on one line.
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_DATABASE_URL=

# --- Everything else is optional and no-ops offline ------------------------
# Razorpay / Dodo / Twilio / WhatsApp / OpenAI / GCS / Pinecone / aggregators are all
# fire-and-forget and simply do nothing without internet. Leave them unset offline.

# Optional: tighten how long an order-create waits on the cloud RTDB push (ms).
# LAN delivery is instant regardless; this only caps the cloud mirror. Default 2000.
# RTDB_PUSH_TIMEOUT_MS=2000
